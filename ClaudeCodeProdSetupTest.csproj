<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>3aca768e-5e30-43bf-b8a3-5c6769c99d3b</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Claude Code config file, not part of the app; the SDK's default content
             globbing would otherwise try to copy it to the output directory. -->
        <Content Remove=".mcp.json" />
    </ItemGroup>

</Project>
